# ==============================================================================
# Keuangan Apotek - Multi-Instance Caddy Docker Proxy Configuration
# ==============================================================================

# Target domain or URL for this instance (managed by caddy-docker-proxy)
# Examples:
#   APP_URL=apotek1.example.com
#   APP_URL=subdomain.domain.id, www.subdomain.domain.id
APP_URL=apotek1.example.com

# Docker network used by caddy-docker-proxy container on your VPS (default: caddy)
CADDY_NETWORK=caddy

# Unique secret string for JWT / auth token signing per instance
AUTH_SECRET=ganti-dengan-string-acak-rahasia-instance-ini

# Optional: Only needed if frontend and backend are hosted on separate domains.
# Leave blank when using the default Nginx reverse proxy.
VITE_API_URL=

# Optional: Initial seeding flags (defaults to false if omitted)
# Set to "true" on first setup if you want default Chart of Accounts and transaction types auto-seeded.
# SEED_DEFAULT_COA=true
# Set to "true" on first setup if you want default users (admin & asisten) auto-seeded.
# SEED_DEFAULT_USERS=true
